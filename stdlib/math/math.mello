fn absolute(x) -> any:
    if x < 0:
        return -x

    return x

fn min_value(a, b) -> any:
    if a > b:
        return b
    else:
        return a

fn max_value(a, b) -> any:
    if a < b:
        return b
    else:
        return a

fn clamp(value, min, max) -> any:
    return max_value(min, min_value(value, max))

fn square(x) -> any:
    return x * x

fn cube(x) -> any:
    return x * x * x

fn lerp(a, b, t) -> any:
    return a + (b - a) * t

fn degrees_to_radians(value) -> float:
    return value * PI / 180.0

fn radians_to_degrees(value) -> float:
    return value * 180.0 / PI

fn isclose(a, b, epsilon) -> bool:
    return absolute(a - b) <= epsilon