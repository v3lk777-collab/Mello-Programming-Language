fn absolute(x) -> float:
    if x < 0:
        return -x

    return x

fn min_value(a, b) -> float:
    if a > b:
        return b
    else:
        return a

fn max_value(a, b) -> float:
    if a < b:
        return b
    else:
        return a

fn clamp(value, min, max) -> float:
    return min_value(max, max_value(value, min))

fn square(x) -> float:
    return x * x

fn cube(x) -> float:
    return x * x * x

fn lerp(a, b, t) -> float:
    return a + (b - a) * t

fn degrees_to_radians(value) -> float:
    return value * PI / 180.0

fn radians_to_degrees(value) -> float:
    return value * 180.0 / PI

fn isclose(a, b, epsilon) -> bool:
    return absolute(a - b) <= epsilon

fn power(base, expression) -> float:
    result = 1.0

    for i in range(0, expression):
        result = result * base

    return result

fn factorial(n) -> float:
    if n <= 1:
        return 1.0

    return float(n) * factorial(n - 1)