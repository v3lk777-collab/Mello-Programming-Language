MELLO_PI = 3.14159265358979323846
MELLO_TWO_PI = 6.28318530717958647692

fn absolute(x) -> float:
    if x < 0:
        return -x

    return x

fn min_value(a, b) -> float:
    if a > b:
        return b
    else:
        return a

fn max_value(a, b) -> float:
    if a < b:
        return b
    else:
        return a

fn clamp(value, min, max) -> float:
    return max_value(min, min_value(value, max))

fn square(x) -> float:
    return x * x

fn cube(x) -> float:
    return x * x * x

fn lerp(a, b, t) -> float:
    return a + (b - a) * t

fn degrees_to_radians(value) -> float:
    return value * MELLO_PI / 180.0

fn radians_to_degrees(value) -> float:
    return value * 180.0 / MELLO_PI

fn isclose(a, b, epsilon) -> bool:
    return absolute(a - b) <= epsilon

fn power(base, expression) -> float:
    result = 1.0

    for i in range(0, expression):
        result *= base

    return result

fn factorial(n) -> float:
    result = 1.0

    for i in range(2, n + 1):
        result *= float(i)

    return result

fn sin(x) -> float:
    v = float(x)

    turns = int(v / MELLO_TWO_PI)
    v -= float(turns) * MELLO_TWO_PI

    if v < 0.0:
        v += MELLO_TWO_PI
    if v > MELLO_PI:
        v -= MELLO_TWO_PI

    result = 0.0
    term = v

    for n in range(1, 11):
        result += term
        multiplier = float(-(v * v) / ((2 * n) * (2 * n + 1)))
        term *= multiplier

    return result

fn cos(x) -> float:
    return sin(x + (MELLO_PI / 2.0))

fn tan(x) -> float:
    return sin(x) / cos(x)

fn sqrt(x) -> float:
    if x < 0.0:
        return -1.0

    if x == 0.0:
        return 0.0

    guess = float(x)

    for i in range(0, 20):
        guess = 0.5 * (guess + x / guess)

    return guess