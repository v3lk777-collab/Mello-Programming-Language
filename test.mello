# Just a blink code btw

pin = 13

start:
    serial.println("BOOTING...")

loop:
    if serial.available() > 0:
        cmd = serial.readStringUntil("\n")

        if cmd == "open":
            turn_on(pin)
            serial.println("Open LED")

        elif cmd == "close":
            turn_off(pin)
            serial.println("Close LED")

        else:
            serial.println("Enter open or close only")