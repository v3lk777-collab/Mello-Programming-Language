    0x00, 0x41, 0x36, 0x08, 0x00, # 125: }
    0x08, 0x08, 0x2A, 0x1C, 0x08  # 126: ~
]

class SSD1306:
    screen_width = 128
    screen_height = 64
    screen_address = 0x78

    oled_sda = 13
    oled_scl = 12

    cursor_page = 0
    cursor_column = 0

    fn command(self, cmd) -> void:
        i2c.begin(self.oled_sda, self.oled_scl)
        i2c.write_byte(self.screen_address)
        i2c.write_byte(0x00)
        i2c.write_byte(cmd)
        i2c.stop()

    fn set_cursor(self, page, column) -> void:
        self.cursor_page = page
        self.cursor_column = column

        self.command(0xB0 + page)
        self.command(0x00 + (column & 0x0F))
        self.command(0x10 + (column >> 4))

    fn invert(self, enabled) -> void:
        if enabled == 1:
            self.command(0xA7)
        else:
            self.command(0xA6)

    fn off(self) -> void:
        self.command(0xAE)

    fn on(self) -> void:
        self.command(0xAF)

    fn set_contrast(self, value) -> void:
        self.command(0x81)
        self.command(value)

    fn clear(self) -> void:
        for page in range(8):
            self.set_cursor(page, 0)

            i2c.begin(self.oled_sda, self.oled_scl)
            i2c.write_byte(self.screen_address)
            i2c.write_byte(0x40)

            for column in range(self.screen_width):
                i2c.write_byte(0x00)

            i2c.stop()

        self.set_cursor(0, 0)

    fn __init__(self, sda, scl) -> void:
        self.oled_sda = sda
        self.oled_scl = scl

        self.command(0xAE)
        self.command(0x20)
        self.command(0x00)
        self.command(0xA1)
        self.command(0xC8)
        self.command(0x8D)
        self.command(0x14)
        self.command(0xAF)

        self.clear()

    fn draw_char(self, c, column, page) -> void:
        if c >= 32 and c <= 126:
            if column >= 0 and column <= 122:
                if page >= 0 and page <= 7:
                    self.set_cursor(page, column)

                    font_index = (c - 32) * 5

                    i2c.begin(self.oled_sda, self.oled_scl)
                    i2c.write_byte(self.screen_address)
                    i2c.write_byte(0x40)

                    for i in range(5):
                        i2c.write_byte(FONT[font_index + i])

                    i2c.write_byte(0x00)
                    i2c.stop()

    fn print(self, text) -> void:
        i = 0

        while text[i] != 0:
            ch = text[i]

            if ch == 10:
                self.cursor_column = 0
                self.cursor_page += 1

                if self.cursor_page > 7:
                    self.cursor_page = 0

                i += 1
                continue

            self.draw_char(ch, self.cursor_column, self.cursor_page)
            self.set_cursor(self.cursor_page, self.cursor_column + 6)

            i += 1

            if self.cursor_column > 122:
                self.cursor_column = 0
                self.cursor_page += 1

                if self.cursor_page > 7:
                    self.cursor_page = 0

    fn println(self, text) -> void:
        self.print(text)

        self.cursor_column = 0
        self.cursor_page += 1

        if self.cursor_page > 7:
            self.cursor_page = 0

    fn draw_line(self, page) -> void:
        if page >= 0 and page <= 7:
            self.set_cursor(page, 0)

            i2c.begin(self.oled_sda, self.oled_scl)
            i2c.write_byte(self.screen_address)
            i2c.write_byte(0x40)

            for column in range(self.screen_width):
                i2c.write_byte(0x08)

            i2c.stop()